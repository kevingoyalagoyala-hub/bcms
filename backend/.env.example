# ---------------------------------------------------------------
# BCMS Backend - Environment Configuration
# Copy this file to ".env" and fill in real values before running.
# ---------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=bcms_user
DB_PASSWORD=change_me
DB_NAME=bcms_db

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# File uploads (stored on disk under /uploads, served statically)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Default admin account seeded on first migration (change password after first login!)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_FULLNAME=Leo M. Mag-Ampo
SEED_ADMIN_ROLE=Punong Barangay
